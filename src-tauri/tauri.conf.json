{
  "$schema": "https://raw.githubusercontent.com/nicoya/tauri-v2/main/schemas/config.schema.json",
  "productName": "Gravix",
  "version": "0.5.0",
  "identifier": "io.github.debaq.gravix",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gravix",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": false,
        "visible": false,
        "center": true
      },
      {
        "label": "splashscreen",
        "title": "Gravix",
        "width": 400,
        "height": 300,
        "decorations": false,
        "resizable": false,
        "center": true,
        "url": "splashscreen.html",
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "media-src": "'self' blob:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' data: blob: ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:5173 ws://localhost:5173",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' http://localhost:5173",
        "style-src": "'self' 'unsafe-inline' http://localhost:5173",
        "img-src": "'self' data: blob: asset: http://asset.localhost http://localhost:5173",
        "font-src": "'self' data: http://localhost:5173",
        "media-src": "'self' blob: http://localhost:5173",
        "worker-src": "'self' blob:",
        "connect-src": "'self' data: blob: ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Debaq/gravix-cnc/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "app",
      "dmg"
    ],
    "publisher": "Nicolás Baier Quezada",
    "copyright": "© 2026 Nicolás Baier Quezada. Todos los derechos reservados.",
    "category": "DeveloperTool",
    "homepage": "https://github.com/Debaq/gravix-cnc",
    "licenseFile": "../LICENSE",
    "shortDescription": "Control CNC/GRBL con CAD 2D y generación de G-code",
    "longDescription": "Gravix es una aplicación de escritorio para control de máquinas CNC, láser, plóter y pluma sobre firmware GRBL. Incluye diseño CAD 2D, generación de G-code, visor 3D de toolpaths y ejecución vía puerto serial.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libudev1",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "rpm": {
        "depends": [
          "systemd-libs",
          "webkit2gtk4.1",
          "gtk3"
        ]
      }
    }
  }
}
